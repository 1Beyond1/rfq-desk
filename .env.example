# RFQ Desk environment configuration example.
# Set these variables in your shell or container environment (no automatic dotenv loader).

# Storage & network
RFQ_DB=
RFQ_BIND_HOST=127.0.0.1
RFQ_PROXY_IPS=127.0.0.1
RFQ_PUBLIC_ORIGIN=http://127.0.0.1:5311

# Authentication & isolation
# Set RFQ_AUTH_REQUIRED=1 for multi-user / public deployments.
RFQ_AUTH_REQUIRED=0
RFQ_COOKIE_SECURE=1
RFQ_VISITOR_SCOPE=0
RFQ_VISITOR_SECRET=
RFQ_ENABLE_DOCS=0

# Guest demo limits
RFQ_DEMO_AI_CALLS=20
RFQ_DEMO_IP_LIMIT=6
RFQ_DEMO_DAILY_CALLS=60

# Primary OpenAI-compatible LLM (required only with `--model` or RFQ_ENABLE_MODEL_REQUESTS=1)
RFQ_ENABLE_MODEL_REQUESTS=0
RFQ_MODEL_URL=
RFQ_MODEL_KEY=
RFQ_MODEL_NAME=
RFQ_MODEL_REASONING_EFFORT=
RFQ_MODEL_MAX_CALLS=100

# Optional fallback LLM route
RFQ_MODEL_FALLBACK_URL=
RFQ_MODEL_FALLBACK_KEY=
RFQ_MODEL_FALLBACK_NAME=

# Optional MatrixOne connection (SQL, vector search, approval snapshots & candidate branches)
RFQ_MO_HOST=
RFQ_MO_PORT=6001
RFQ_MO_USER=
RFQ_MO_PASSWORD=
RFQ_MO_DB=rfq_desk

# Optional auxiliary triage & rerank models
RFQ_JEV_KEY=
RFQ_REFERENCE_RERANK=0

# Optional MOI Catalog snapshot contract (disabled by default)
RFQ_ENABLE_PLATFORM_SNAPSHOT_REQUESTS=0
RFQ_MOI_BASE_URL=https://api.moi.matrixorigin.cn/v5
RFQ_MOI_API_KEY=
RFQ_MOI_WORKSPACE_ID=
RFQ_MOI_VOLUME_ID=
