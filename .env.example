# Documentation only: set these in the current shell; no automatic dotenv loader.
# Product database defaults to ./var/rfq.sqlite3
RFQ_DB=
# Account login (off only for isolated/local legacy review). Public rollout requires 1.
RFQ_AUTH_REQUIRED=0
RFQ_COOKIE_SECURE=1
RFQ_PUBLIC_ORIGIN=http://127.0.0.1:5311
# Complete chat/tool-call endpoint for synthetic baseline only
RFQ_MODEL_URL=
RFQ_MODEL_KEY=
RFQ_MODEL_NAME=
# API and Web are bound by scripts/start.ps1 to 127.0.0.1:8311 / :5311.
# Real model calls require explicit enablement and configured credentials.
# Optional MOI Catalog snapshot contract preparation; no app hooks or live CLI.
# Enabling this alone never authorizes live transmission. See docs/PLATFORM_READINESS.md.
RFQ_ENABLE_PLATFORM_SNAPSHOT_REQUESTS=0
RFQ_MOI_BASE_URL=https://api.moi.matrixorigin.cn/v5
RFQ_MOI_API_KEY=
RFQ_MOI_WORKSPACE_ID=
RFQ_MOI_VOLUME_ID=

# Optional inbox triage; never put real keys in this example.
RFQ_JEV_KEY=
# Agent reference search reranking (UI can request reranking independently).
RFQ_REFERENCE_RERANK=0
